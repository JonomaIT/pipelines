        {
          "type": "generic",
          "path": ".github/workflows/build-static.yml"
        },
        {
          "type": "generic",
          "path": ".github/workflows/deploy-app.yml"
        },
        {
          "type": "generic",
          "path": ".github/workflows/dependabot.yml"
        }
      ]
    }
  }
}

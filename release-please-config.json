  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bootstrap-sha": "177bbd1ec7cbd227c4b886cdc184a1439673cfad",
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
